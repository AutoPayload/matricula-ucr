@model IEnumerable<Docente>
@{ ViewData["Title"] = "Docentes"; }

<h1>Docentes</h1>
<p><a asp-action="Create" class="btn btn-primary">Crear nuevo docente</a></p>
<table class="table table-striped">
<thead class="table-dark"><tr><th>Nombre</th><th>Especialidad</th><th class="text-end">Acciones</th></tr></thead>
<tbody>
@foreach (var item in Model)
{
<tr><td>@item.Nombre</td><td>@item.Especialidad</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a></td></tr>
}
</tbody></table>
