@model Docente
@{ ViewData["Title"] = "Editar docente"; }

<h1>Editar docente</h1><hr />
<div class="row"><div class="col-md-6">
<form asp-action="Edit"><div asp-validation-summary="All" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Especialidad" class="form-label"></label><input asp-for="Especialidad" class="form-control" /><span asp-validation-for="Especialidad" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
