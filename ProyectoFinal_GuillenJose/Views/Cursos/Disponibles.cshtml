@model IEnumerable<Curso>
@{ ViewData["Title"] = "Cursos disponibles"; }

<h1>Cursos disponibles</h1>
<p class="lead">Carrera: @ViewBag.CarreraNombre</p><hr />
@if (!Model.Any())
{
<div class="alert alert-info">No hay cursos disponibles para su carrera en este momento.</div>
}
else
{
<div class="row">
@foreach (var curso in Model)
{
<div class="col-md-4 mb-4"><div class="card h-100 shadow-sm"><div class="card-body"><h5 class="card-title">@curso.Nombre</h5><h6 class="card-subtitle mb-2 text-muted">@curso.Codigo</h6><p class="card-text">@curso.Creditos créd. | Docente: @(curso.Docente?.Nombre ?? "Sin asignar")</p></div><div class="card-footer bg-white border-top-0"><a asp-action="Detalle" asp-route-id="@curso.Id" class="btn btn-primary btn-sm w-100">Ver detalle</a></div></div></div>
}
</div>
}
