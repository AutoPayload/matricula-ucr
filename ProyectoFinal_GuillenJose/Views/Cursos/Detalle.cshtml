@model Curso
@{ ViewData["Title"] = "Detalle del curso"; }

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}
<h1>@Model.Nombre</h1><hr />
<dl class="row"><dt class="col-sm-3">Código</dt><dd class="col-sm-9">@Model.Codigo</dd><dt class="col-sm-3">Créditos</dt><dd class="col-sm-9">@Model.Creditos</dd><dt class="col-sm-3">Carrera</dt><dd class="col-sm-9">@(Model.Carrera?.Nombre ?? "-")</dd><dt class="col-sm-3">Docente</dt><dd class="col-sm-9">@(Model.Docente?.Nombre ?? "Sin asignar")</dd><dt class="col-sm-3">Cupos disponibles</dt><dd class="col-sm-9">@Model.Cupos (Inscritos: @ViewBag.Inscritos)</dd><dt class="col-sm-3">Período</dt><dd class="col-sm-9">@ViewBag.Periodo</dd></dl>
<form asp-controller="Matriculas" asp-action="Matricular" method="post"><input type="hidden" name="cursoId" value="@Model.Id" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-lg">Matricularme</button> <a asp-action="Disponibles" class="btn btn-secondary">Volver</a></form>
