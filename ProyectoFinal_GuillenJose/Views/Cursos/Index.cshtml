@model IEnumerable<Curso>
@{ ViewData["Title"] = "Administrar cursos"; }

<h1>Cursos</h1>
<p><a asp-action="Create" class="btn btn-primary">Crear nuevo curso</a></p>
<table class="table table-striped">
<thead class="table-dark"><tr><th>Código</th><th>Nombre</th><th>Créditos</th><th>Carrera</th><th>Docente</th><th>Cupos</th><th class="text-end">Acciones</th></tr></thead>
<tbody>
@foreach (var item in Model)
{
<tr><td>@item.Codigo</td><td>@item.Nombre</td><td>@item.Creditos</td><td>@(item.Carrera?.Nombre ?? "-")</td><td>@(item.Docente?.Nombre ?? "Sin asignar")</td><td>@item.Cupos</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a></td></tr>
}
</tbody></table>
