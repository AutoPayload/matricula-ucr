@model IEnumerable<Matricula>
@{ ViewData["Title"] = "Mis cursos"; }

<h1>Mis cursos matriculados</h1>
<p class="lead">Período actual: @ViewBag.Periodo</p><hr />
@if (TempData["Exito"] is not null)
{
<div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["Exito"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}
@if (!Model.Any())
{
<div class="alert alert-info">No tiene cursos matriculados en el periodo actual. <a asp-controller="Cursos" asp-action="Disponibles" class="alert-link">Ver cursos disponibles</a>.</div>
}
else
{
<table class="table table-striped">
<thead class="table-dark"><tr><th>Código</th><th>Curso</th><th>Carrera</th><th>Docente</th><th>Créditos</th><th>Fecha matrícula</th></tr></thead>
<tbody>
@foreach (var m in Model)
{
<tr><td>@m.Curso?.Codigo</td><td>@m.Curso?.Nombre</td><td>@(m.Curso?.Carrera?.Nombre ?? "-")</td><td>@(m.Curso?.Docente?.Nombre ?? "Sin asignar")</td><td>@m.Curso?.Creditos</td><td>@m.FechaMatricula.ToString("dd/MM/yyyy HH:mm")</td></tr>
}
</tbody></table>
}
