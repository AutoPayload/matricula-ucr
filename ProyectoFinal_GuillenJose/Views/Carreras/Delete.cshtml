@model Carrera
@{ ViewData["Title"] = "Eliminar carrera"; }

<h1>Eliminar carrera</h1><hr />
<div class="alert alert-danger"><h4>¿Confirma que desea eliminar esta carrera?</h4></div>
<dl class="row"><dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd><dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@Model.Descripcion</dd></dl>
<form asp-action="Delete"><input type="hidden" asp-for="Id" /><button type="submit" class="btn btn-danger">Eliminar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></form>
