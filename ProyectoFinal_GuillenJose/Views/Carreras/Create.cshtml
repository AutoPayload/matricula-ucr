@model Carrera
@{ ViewData["Title"] = "Crear carrera"; }

<h1>Crear carrera</h1><hr />
<div class="row"><div class="col-md-6">
<form asp-action="Create"><div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control" rows="3"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
