@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center my-5">
    <h1 class="display-3">Sistema de Matrícula Universitaria</h1>
    <p class="lead mt-3">Gestione carreras, cursos, docentes y realice su matrícula de forma sencilla.</p>
    <hr class="my-4" />
    <div class="row justify-content-center mt-5">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Estudiantes</h5>
                    <p class="card-text">Regístrese, explore los cursos de su carrera y matricúlese.</p>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">Registrarse</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Administradores</h5>
                    <p class="card-text">Gestione carreras, cursos y docentes del sistema.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-dark">Iniciar sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>
