@model PeriodoAcademico

<nav class="migas"><a asp-action="Index">Periodos</a><span>·</span>Nuevo</nav>

<div class="encabezado-pagina">
    <div>
        <span class="rotulo">Administración</span>
        <h1>Nuevo periodo académico</h1>
        <p>El periodo nace planificado. Ábralo cuando quiera habilitar la matrícula.</p>
    </div>
</div>

<div class="tarjeta" style="max-width:820px">
    <form asp-action="Crear" method="post" class="formulario formulario--2" data-evitar-doble-envio>
        <partial name="_Formulario" model="Model" />
        <div class="campo--ancho acciones">
            <button type="submit" class="boton boton--principal">Crear periodo</button>
            <a class="boton boton--sutil" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ScriptsValidacion" /> }
