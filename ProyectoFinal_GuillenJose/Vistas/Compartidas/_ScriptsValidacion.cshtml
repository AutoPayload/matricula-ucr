@*
    Validación en el navegador. Se apoya en jQuery Validation, que ya viene con la plantilla
    de ASP.NET Core, para que las mismas anotaciones de datos que valida el servidor avisen
    también antes de enviar el formulario.
*@
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
