@model ResultadoPaginado<FilaGrupo>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var periodos = ViewData["Periodos"] as List<SelectListItem> ?? [];
    var docentes = ViewData["Docentes"] as List<SelectListItem> ?? [];
    var periodoId = ViewBag.PeriodoId as int?;
    var docenteId = ViewBag.DocenteId as int?;
    var texto = ViewBag.Texto as string;
    var estadoFiltro = ViewBag.EstadoFiltro as EstadoGrupo?;
}

<div class="encabezado-pagina">
    <div>
        <span class="rotulo">Administración</span>
        <h1>Grupos</h1>
        <p>
            Oferta de cada periodo. Aquí se asigna la persona docente, el horario, el aula y el
            cupo de cada grupo.
        </p>
    </div>
    <div class="acciones">
        <a class="boton boton--principal" asp-action="Crear" asp-route-periodoId="@periodoId">
            <svg class="icono" aria-hidden="true"><use href="#icono-mas"></use></svg>
            Nuevo grupo
        </a>
    </div>
</div>

<form class="filtros" method="get" asp-action="Index">
    <div class="campo campo--busqueda">
        <label for="texto">Buscar</label>
        <input type="search" id="texto" name="texto" value="@texto"
               placeholder="Curso o aula" autocomplete="off" />
    </div>
    <div class="campo">
        <label for="periodoId">Periodo</label>
        <select id="periodoId" name="periodoId">
            <option value="">Todos</option>
            @foreach (var opcion in periodos)
            {
                <option value="@opcion.Value" selected="@(periodoId?.ToString() == opcion.Value)">@opcion.Text</option>
            }
        </select>
    </div>
    <div class="campo">
        <label for="docenteId">Docente</label>
        <select id="docenteId" name="docenteId">
            <option value="">Todos</option>
            @foreach (var opcion in docentes)
            {
                <option value="@opcion.Value" selected="@(docenteId?.ToString() == opcion.Value)">@opcion.Text</option>
            }
        </select>
    </div>
    <div class="campo">
        <label for="estado">Estado</label>
        <select id="estado" name="estado">
            <option value="">Todos</option>
            @foreach (var valor in Enum.GetValues<EstadoGrupo>())
            {
                <option value="@valor" selected="@(estadoFiltro == valor)">@valor.Describir()</option>
            }
        </select>
    </div>
    <div class="acciones">
        <button type="submit" class="boton boton--pequeno">Filtrar</button>
        <a class="boton boton--sutil boton--pequeno" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (Model.TotalElementos == 0)
{
    <div class="vacio">
        <h3>No hay grupos que coincidan</h3>
        <p>Ajuste los criterios o cree un grupo nuevo para el periodo.</p>
    </div>
}
else
{
    <div class="tabla-envoltura">
        <table class="tabla">
            <thead>
                <tr>
                    <th>Grupo</th>
                    <th>Periodo</th>
                    <th>Docente</th>
                    <th>Horario</th>
                    <th>Ocupación</th>
                    <th class="angosta">Estado</th>
                    <th class="angosta"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in Model.Elementos)
                {
                    <tr>
                        <td>
                            <span class="celda-principal">@fila.Etiqueta</span>
                            <span class="celda-secundaria">@fila.NombreCurso</span>
                        </td>
                        <td class="mono diminuto">@fila.Periodo</td>
                        <td>@fila.Docente</td>
                        <td>
                            @fila.Horario
                            <span class="celda-secundaria">Aula @fila.Aula</span>
                        </td>
                        <td><barra-ocupacion inscritos="@fila.Inscritos" cupo="@fila.CupoMaximo" /></td>
                        <td class="angosta">
                            <indicador-estado grupo="@fila.Estado" />
                            @if (fila.ActaCerrada)
                            {
                                <span class="celda-secundaria">Acta cerrada</span>
                            }
                        </td>
                        <td class="angosta">
                            <span class="fila" style="gap:4px; flex-wrap:nowrap">
                                <a class="boton boton--sutil boton--pequeno" asp-action="Editar" asp-route-id="@fila.Id" title="Editar">
                                    <svg class="icono" aria-hidden="true"><use href="#icono-editar"></use></svg>
                                </a>
                                <a class="boton boton--sutil boton--pequeno" asp-action="Eliminar" asp-route-id="@fila.Id" title="Eliminar">
                                    <svg class="icono" aria-hidden="true"><use href="#icono-eliminar"></use></svg>
                                </a>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <paginador pagina-actual="@Model.PaginaActual" total-paginas="@Model.TotalPaginas"
               total-elementos="@Model.TotalElementos" primera-fila="@Model.PrimeraFila"
               ultima-fila="@Model.UltimaFila" accion="Index" controlador="Grupos"
               nombre-singular="grupo" nombre-plural="grupos"
               filtro-texto="@texto" filtro-periodoId="@periodoId?.ToString()"
               filtro-docenteId="@docenteId?.ToString()" filtro-estado="@estadoFiltro?.ToString()" />
}
