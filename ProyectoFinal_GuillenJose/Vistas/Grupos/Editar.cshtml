@model Grupo

<nav class="migas"><a asp-action="Index">Grupos</a><span>·</span>Editar</nav>

<div class="encabezado-pagina">
    <div>
        <span class="rotulo">Administración</span>
        <h1>Editar grupo</h1>
        <p>El cupo no puede quedar por debajo de la cantidad de personas ya matriculadas.</p>
    </div>
</div>

<div class="tarjeta" style="max-width:820px">
    <form asp-action="Editar" method="post" class="formulario formulario--2" data-evitar-doble-envio>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ProgramaDocumentoId" />
        <input type="hidden" asp-for="ActaCerrada" />
        <partial name="_Formulario" model="Model" />
        <div class="campo--ancho acciones">
            <button type="submit" class="boton boton--principal">Guardar cambios</button>
            <a class="boton boton--sutil" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ScriptsValidacion" /> }
